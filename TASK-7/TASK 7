USE ecommerce_db;

SELECT * FROM Product;

SELECT product_id, product_name, price, stocks
FROM Product;

SELECT *
FROM Product
WHERE price < 30000;

SELECT *
FROM Product
WHERE stock > 0;

SELECT *
FROM Product
ORDER BY price ASC;

SELECT *
FROM Product
ORDER BY price DESC;

SELECT DISTINCT category_id
FROM Product;

SELECT DISTINCT payment_mode
FROM Payment;

SELECT *
FROM Product
WHERE price BETWEEN 500 AND 30000;

SELECT *
FROM Product
WHERE category_id = 1;

SELECT *
FROM Product
WHERE stock > 0;


SELECT *
FROM Product
WHERE stock = 0;

SELECT *
FROM Customer;

SELECT customer_name, email, phone
FROM Customer;

SELECT
    c.customer_name,
    c.email,
    o.order_id,
    o.order_date,
    o.total_amount
FROM Customer c
JOIN Orders o
ON c.customer_id = o.customer_id;

SELECT
    p.product_id,
    p.product_name,
    c.category_name,
    p.price,
    p.stock
FROM Product p
JOIN Category c
ON p.category_id = c.category_id;

SELECT *
FROM Product
WHERE price > 1000
AND stock > 0;

SELECT *
FROM Product
WHERE price < 30000
OR stock = 0;

SELECT COUNT(*) AS total_products
FROM Product;

SELECT SUM(stock) AS total_stock
FROM Product;

SELECT AVG(price) AS average_price
FROM Product;

SELECT MAX(price) AS highest_price
FROM Product;

SELECT MIN(price) AS lowest_price
FROM Product;

SELECT
    c.category_name,
    COUNT(p.product_id) AS total_products,
    SUM(p.stock) AS total_stock,
    AVG(p.price) AS average_price
FROM Category c
LEFT JOIN Product p
ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name;

SELECT 
    c.customer_name,
    COUNT(o.order_id) AS total_orders,
    SUM(o.total_amount) AS total_spent
FROM
    Customer c
        LEFT JOIN
    Orders o ON c.customer_id = o.customer_id
GROUP BY c.customer_id , c.customer_name
ORDER BY total_spent DESC;
